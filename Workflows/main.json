    {
      "parameters": {
        "jsCode": "// 1. 取出 OpenAI 回傳的原始 content 字串\nconst raw = $input.first().json.choices[0].message.content;\n\n// 2. 去除 ```json 和 ``` fence\nconst cleaned = raw\n  .replace(/```json\\s*/, '')   // 去掉開頭 ```json\n  .replace(/```$/, '')         // 去掉尾端 ```\n  .trim();\n\n// 3. 解析成物件\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error(`無法解析回傳內容: ${e.message}\\n解析前字串：\\n${cleaned}`);\n}\n\n// 4. 解構需要的欄位\nconst { comments, credibility } = parsed;\n\n// 5. 回傳成新的 item\nreturn [\n  {\n    json: {\n      comments,\n      credibility\n    }\n  }\n];\n"
      },
